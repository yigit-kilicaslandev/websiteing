---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import HomePage from "@/components/HomePage";
---

<Layout>
  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.setAttribute("data-entrance-pending", "");
      // Leave the page readable if hydration or a third-party request stalls.
      window.setTimeout(() => {
        document.documentElement.removeAttribute("data-entrance-pending");
      }, 4000);
    }
  </script>
  <HomePage client:load />
  <script is:inline>
    // Restore the disclosure's height before native scroll restoration.
    try {
      const credits = document.getElementById("photo-credits");
      const saved = localStorage.getItem("photo-credits-open");
      if (credits && saved !== null) credits.open = saved === "true";
    } catch (_) {}
  </script>
</Layout>

<style is:global>
  html[data-entrance-pending] [data-entrance] {
    opacity: 0 !important;
  }
</style>
